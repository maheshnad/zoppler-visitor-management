DATABASE_URL=postgresql://visitor_app:REPLACE_PASSWORD@localhost:5432/zoppler_visitors
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_USERNAME=REPLACE_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
SMTP_FROM=visitor-management@zopplersystems.com
# Recommended for Render: HTTPS email delivery, which avoids SMTP-port restrictions.
# Set this instead of SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD when using Resend.
# RESEND_API_KEY=re_xxxxxxxxx
